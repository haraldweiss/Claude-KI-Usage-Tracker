*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
.next/

# Frontend
frontend/dist/

# Backend
backend/node_modules/

# Testing
coverage/

# Linting
.eslintcache
.prettierignore

# Claude Code local overrides (personal, never commit)
.claude/settings.local.json

# ECC agents config (per-clone, not portable)
.agents/
.codex/

# Worktrees created by the harness for isolated feature work — they
# contain a full checkout of the repo and must never be committed.
.claude/worktrees/
.worktrees/

# Serena MCP scratch / language-server cache (per-clone, not portable).
.serena/

# Compiled TS output that lives next to .ts source (now using tsx for dev,
# dist/ for prod). Keep .js test files (jest still runs them).
backend/src/**/*.js
!backend/src/__tests__/**/*.js

# Benchmark runner artifacts (generated results + state)
benchmark/results/
benchmark/benchmark/results/
benchmark/state.json

# Pale Moon XPI build artifact
ki-usage-tracker-palemoon.xpi

# Local coding-agent approvals and transcripts can contain credentials.
**/.claude/settings.local.json
**/.claude/history.jsonl
**/.claude/projects/
**/.claude/transcripts/
.specstory/
.aider.chat.history.md
.aider.input.history

# Database backups may contain tokens and other private runtime data.
*.sqlite.bak*
*.sqlite3.bak*
*.db.bak*
